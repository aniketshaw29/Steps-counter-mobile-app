{
  "expo": {
    "name": "Steps Counter",
    "slug": "aniket-shaw",
    "version": "1.0.0",
    "scheme": "stepscounter",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBFE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aniketshaw29.stepscounter",
      "infoPlist": {
        "NSMotionUsageDescription": "Steps Counter uses your phone's motion sensor to count steps. Your data never leaves your device.",
        "NSHealthShareUsageDescription": "Steps Counter reads your step data from Apple Health.",
        "NSHealthUpdateUsageDescription": "Steps Counter writes your step data to Apple Health.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aniketshaw29.stepscounter",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6750A4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-router",
        {
          "root": "app"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6750A4"
        }
      ],
      "expo-sharing",
      "react-native-health-connect"
    ],
    "extra": {
      "eas": {
        "projectId": "ffe8e0ff-6e18-4390-869b-f16243eda1ed"
      }
    }
  }
}
