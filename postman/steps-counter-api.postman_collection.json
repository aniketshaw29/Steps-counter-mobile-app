{
  "info": {
    "_postman_id": "steps-counter-api-v1",
    "name": "Steps Counter API",
    "description": "Postman collection for the Steps Counter app API.\n\nNOTE: v1 of this app is fully offline — no backend API exists yet.\nThis collection is a placeholder for Phase 3+ when cloud sync is added.\n\nPlanned endpoints (Phase 3):\n  POST /auth/register\n  POST /auth/login\n  GET  /steps/sync\n  POST /steps/sync\n  GET  /goals\n  PUT  /goals/:date\n  GET  /achievements\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL — update when backend is deployed"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "JWT token — set after login"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Steps",
      "item": [
        {
          "name": "Sync steps (upload)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/steps/sync",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    { \"date\": \"2026-07-31\", \"steps\": 8432, \"distance_m\": 6324, \"calories\": 210, \"goal_steps\": 10000, \"goal_met\": false }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get synced steps",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/steps/sync?from=2026-07-01&to=2026-07-31",
              "query": [
                { "key": "from", "value": "2026-07-01" },
                { "key": "to", "value": "2026-07-31" }
              ]
            }
          }
        }
      ]
    }
  ]
}
